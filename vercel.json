{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/model_catalog", "destination": "/models", "permanent": true }
  ],
  "rewrites": [
    { "source": "/og/:kind/:id.png", "destination": "/api/og?kind=:kind&id=:id" }
  ],
  "headers": [
    {
      "source": "/models/(.*)",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/models/(.*)\\.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/compare/(.*)",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/compare/(.*)\\.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/rankings/(.*)\\.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/new-models/(.*)\\.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/new-models.xml",
      "headers": [{ "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/llms-full.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}
