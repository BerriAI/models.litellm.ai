{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/model_catalog", "destination": "/models", "permanent": true }
  ],
  "rewrites": [
    { "source": "/providers", "destination": "/index.html" },
    { "source": "/cookbook", "destination": "/index.html" },
    { "source": "/guardrails", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/models/(.*)",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/models/(.*)\\.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}
