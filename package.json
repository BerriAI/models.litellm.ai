{
  "name": "open-llm-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run changelog && vite build && npm run seo && npm run seo:check",
    "seo": "vite-node scripts/seo/generate.ts",
    "seo:check": "vite-node scripts/seo/validate.ts",
    "og:preview": "vite-node scripts/seo/og-preview.ts",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "test": "vitest run",
    "changelog": "vite-node scripts/changelog/generate.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tsconfig/svelte": "^5.0.4",
    "@types/sql.js": "^1.4.11",
    "happy-dom": "20.14.5",
    "prettier": "^3.3.1",
    "prettier-plugin-svelte": "^3.2.3",
    "svelte": "^5.59.2",
    "svelte-check": "^3.6.7",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2",
    "vite": "^5.3.5",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@resvg/resvg-js": "2.6.2",
    "@vercel/firewall": "1.2.6",
    "dompurify": "^3.4.18",
    "fflate": "0.8.2",
    "fuse.js": "^7.0.0",
    "marked": "^17.0.1",
    "mixpanel-browser": "^2.73.0",
    "satori": "0.47.1",
    "sql.js": "^1.16.0",
    "svelte-typewriter": "^3.2.3"
  }
}
